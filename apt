#!/bin/sh
# apt: a friendly front end for apt-get, apt-cache and dpkg on Maemo 5 (apt 0.7).
# Provides the commands of modern apt (list --upgradable, search, show, ...) and readable output.
# It only calls the system tools: nothing of the package system is replaced.

VERSION=0.1
APT_GET=${APT_GET:-apt-get}
APT_CACHE=${APT_CACHE:-apt-cache}
DPKG_QUERY=${DPKG_QUERY:-dpkg-query}

if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
    B=$(printf '\033[1m'); G=$(printf '\033[32m'); Y=$(printf '\033[33m'); C=$(printf '\033[36m'); R=$(printf '\033[0m')
else
    B=; G=; Y=; C=; R=
fi

usage() {
    cat <<EOT
Usage: apt COMMAND [ARGS]

  update                      refresh the package lists
  list [--upgradable|--installed] [PATTERN]
                              list packages (default: upgradable)
  upgrade                     install the available upgrades (asks first)
  full-upgrade                the same, may install or remove packages (dist-upgrade)
  install PKG...              install packages
  remove PKG...               remove packages (keep configuration)
  purge PKG...                remove packages and configuration
  autoremove                  remove packages no longer needed
  clean                       delete downloaded .deb files
  search WORDS                search names and descriptions
  show PKG                    show package details
  policy [PKG]                show versions and repositories
  files PKG                   list files of an installed package
  owns FILE                   find the installed package that owns FILE
  -h, --help | --version

Commands that change the system run through sudo when you are not root.
Other options are passed to apt-get (for example: apt install -y PKG, apt upgrade -s).
EOT
}

# Run a command as root (the phone user normally has sudo).
as_root() {
    if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi
}

# Print "name old -> new" for the packages in a simulated run. Lines of apt-get -s look like
#   Inst name [old] (new Repo:Name [armel])   (upgrade)      Inst name (new Repo [armel])   (new package)
simulate() {
    "$APT_GET" -s "$@" 2>/dev/null | sed -n \
        -e 's/^Inst \([^ ]*\) \[\([^]]*\)\] (\([^ ]*\) .*$/U \1 \2 \3/p' \
        -e 's/^Inst \([^ ]*\) (\([^ ]*\) .*$/N \1 - \2/p'
}

list_upgradable() {
    pattern=$1
    out=$(simulate dist-upgrade)
    if [ -z "$out" ]; then
        echo "All packages are up to date."
        return 0
    fi
    echo "$out" | awk -v pat="$pattern" -v b="$B" -v g="$G" -v y="$Y" -v r="$R" '
        pat != "" && index($2, pat) == 0 { next }
        $1 == "U" { printf "%s%s%s %s%s%s -> %s%s%s\n", b, $2, r, y, $3, r, g, $4, r; up++ }
        $1 == "N" { printf "%s%s%s (new dependency) %s%s%s\n", b, $2, r, g, $4, r; nw++ }
        END { printf "\n%d upgradable", up; if (nw) printf ", %d new", nw; printf ". Run: apt upgrade\n" }'
}

list_installed() {
    "$DPKG_QUERY" -W -f '${Package} ${Version} ${Status}\n' 2>/dev/null |
        awk -v pat="$1" -v b="$B" -v g="$G" -v r="$R" '
            $NF == "installed" && (pat == "" || index($1, pat)) { printf "%s%s%s %s%s%s\n", b, $1, r, g, $2, r; n++ }
            END { printf "\n%d installed\n", n }'
}

cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
    ""|-h|--help|help) usage ;;
    --version|-v|version) echo "apt-n900 $VERSION (front end for $("$APT_GET" --version | head -1))" ;;
    update) as_root "$APT_GET" update "$@" ;;
    list)
        mode=upgradable; pattern=
        for a in "$@"; do
            case $a in
                --upgradable|-u) mode=upgradable ;;
                --installed|-i) mode=installed ;;
                -*) echo "apt: unknown option $a" >&2; exit 2 ;;
                *) pattern=$a ;;
            esac
        done
        if [ $mode = installed ]; then list_installed "$pattern"; else list_upgradable "$pattern"; fi
        ;;
    upgrade) as_root "$APT_GET" upgrade "$@" ;;
    full-upgrade|dist-upgrade) as_root "$APT_GET" dist-upgrade "$@" ;;
    install|remove|purge|autoremove|clean)
        # -s (simulation) needs no root
        case " $* " in *" -s "*|*" --simulate "*) "$APT_GET" "$cmd" "$@" ;; *) as_root "$APT_GET" "$cmd" "$@" ;; esac ;;
    search)
        [ $# -gt 0 ] || { echo "apt search: give at least one word" >&2; exit 2; }
        "$APT_CACHE" search "$@" | awk -v b="$B" -v r="$R" '{ n = index($0, " - "); if (n) printf "%s%s%s%s\n", b, substr($0, 1, n - 1), r, substr($0, n); else print }'
        ;;
    show) [ $# -gt 0 ] || { echo "apt show: give a package" >&2; exit 2; }; "$APT_CACHE" show "$@" ;;
    policy) "$APT_CACHE" policy "$@" ;;
    files) [ $# -eq 1 ] || { echo "Usage: apt files PKG" >&2; exit 2; }; "$DPKG_QUERY" -L "$1" ;;
    owns) [ $# -eq 1 ] || { echo "Usage: apt owns FILE" >&2; exit 2; }; "$DPKG_QUERY" -S "$1" ;;
    *) echo "apt: unknown command '$cmd' (apt --help)" >&2; exit 2 ;;
esac
